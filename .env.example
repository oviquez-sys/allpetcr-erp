# ============================================================
#  ALLPETCR ERP — Variables de entorno
#  Copiá este archivo como ".env" y completá los valores.
#  NUNCA subas el .env real a git (ya está en .gitignore).
# ============================================================

# --- PRODUCCIÓN ---
# Poné 1 SOLO en el servidor. Activa todo el blindaje (HTTPS, cookies seguras,
# HSTS) y apaga DEBUG. En tu computadora de pruebas dejalo vacío o quitá la línea.
DJANGO_PRODUCTION=1

# Llave secreta: OBLIGATORIA en producción. Generá una así:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=pega-aqui-una-llave-larga-y-aleatoria

# Dominios/hosts permitidos, separados por coma (sin http://).
DJANGO_ALLOWED_HOSTS=allpetcr.com,www.allpetcr.com

# Orígenes de confianza para formularios (con https://), separados por coma.
DJANGO_CSRF_ORIGINS=https://allpetcr.com,https://www.allpetcr.com

# --- BASE DE DATOS ---
# En producción: PostgreSQL. Definí POSTGRES_HOST para activarlo.
POSTGRES_HOST=localhost
POSTGRES_DB=allpetcr
POSTGRES_USER=allpetcr
POSTGRES_PASSWORD=pon-una-clave-fuerte
POSTGRES_PORT=5432

# En local con SQLite (sin las variables POSTGRES_*): podés mover la base FUERA
# de OneDrive para evitar corrupción por sincronización. Ejemplo en Windows:
#   DJANGO_DB_PATH=C:\allpetcr-datos\db.sqlite3
# DJANGO_DB_PATH=

# --- LOGIN SEGURO (fuerza bruta) ---
# Requiere: pip install django-axes
DJANGO_ENABLE_AXES=1

# --- LOGS ---
# Carpeta donde se guardan los registros en producción (por defecto ./logs).
# DJANGO_LOG_DIR=/var/log/allpetcr

# --- FISCAL ---
# Salario base del año (para el límite del régimen simplificado).
# Actualizar cada enero con el decreto vigente. Por defecto: 462200 (2026).
# SALARIO_BASE=462200
